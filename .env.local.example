# Copy this file to .env.local and fill in the credentials.

# Mail provider (choose one provider)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=

# Or use Resend API (leave SMTP_HOST empty to use Resend)
# RESEND_API_KEY=

# Recipients (comma-separated)
# MAIL_TO=

# Google Drive upload (optional)
# Google Drive upload (OAuth2)
# Obtain an OAuth2 client ID/secret and generate a refresh token for the Drive account
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# Parent Drive folder ID where year/month folders will be created
# GOOGLE_DRIVE_FOLDER_ID=1eo0sL-_KWR175y9z31cyKQiv_kvgeoKh
